<Window x:Class="Nexus.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Nexus Harness" Height="850" Width="1400" MinHeight="600" MinWidth="800" WindowStartupLocation="CenterScreen" Icon="Assets/Nexus.ico" Background="#F5F7F8">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D9E1E5" BorderThickness="0,0,0,1" Padding="20,10">
      <DockPanel><Button DockPanel.Dock="Right" Content="Settings" Padding="16,7" Click="OpenSettings"/><TextBlock Text="Nexus Harness" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#153C50"/></DockPanel>
    </Border>
    <Grid>
      <StackPanel Name="Unavailable" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="480">
        <TextBlock Text="Monitor is not available" FontSize="22" FontWeight="SemiBold" Foreground="#153C50"/>
        <TextBlock Name="ErrorText" Margin="0,12,0,18" TextWrapping="Wrap" Foreground="#344B57"/>
        <StackPanel Orientation="Horizontal"><Button Content="Retry" Padding="18,8" Click="RetryMonitor"/><Button Content="Open settings" Padding="18,8" Margin="10,0,0,0" Click="OpenSettings"/></StackPanel>
      </StackPanel>
      <wv:WebView2 Name="Browser" />
    </Grid>
  </DockPanel>
</Window>
